# Development container for VS Code Remote-Containers (.devcontainer/devcontainer.json).
# Dev only -- published images are built by Dockerfile.prod.
FROM eclipse-temurin:17-jdk AS dev

ENV TZ=America/New_York
ENV DEBIAN_FRONTEND=noninteractive
ENV GRADLE_HOME=/opt/gradle/latest
ENV PATH=${GRADLE_HOME}/bin:$PATH

# Where HEC-HMS is installed. build.gradle now defaults hmsHome to this same
# path and .vscode/launch.json points java.library.path, GDAL_DATA and PROJ_LIB
# at it, so a bare `gradle build` and an F5 debug session agree. Dockerfile.prod
# installs to /opt/hms and passes -PhmsHome, so it is independent of this.
ENV HMS_HOME=/hms

#need to get the jdk.
# One install call, no repeated packages. The tarball and the zip are deleted in
# the layer that fetched them -- keeping /hec-hms.tar.gz around cost about 1 GB
# of image size -- and --strip-components=1 is what lets HMS_HOME be /hms rather
# than whatever directory HEC named inside the tarball.
RUN apt-get update &&\
    apt-get install -y --no-install-recommends wget git unzip ca-certificates libxrender1 libxtst6 libxi6 libfreetype6 libgfortran5 libfontconfig1 &&\
    wget -O /hec-hms.tar.gz https://www.hec.usace.army.mil/nexus/repository/maven-public/mil/army/usace/hec/hec-hms/4.13-beta.6-linux64/hec-hms-4.13-beta.6-linux64.tar.gz &&\
    mkdir -p ${HMS_HOME} &&\
    tar -xzf /hec-hms.tar.gz -C ${HMS_HOME} --strip-components=1 &&\
    rm -f /hec-hms.tar.gz &&\
    wget -O /tmp/gradle.zip https://services.gradle.org/distributions/gradle-7.3.1-bin.zip &&\
    unzip -q -d /opt/gradle /tmp/gradle.zip &&\
    ln -s /opt/gradle/gradle-7.3.1 /opt/gradle/latest &&\
    rm -f /tmp/gradle.zip

# Verification. Fail the image build here instead of at the first gradle run:
# hms.jar and lib are the compile classpath build.gradle reads, bin/gdal is the
# first entry of java.library.path in .vscode/launch.json, and the archive is
# already gone, so this is the last point that can still report a truncated
# download. cc-java-sdk is deliberately not fetched here: build.gradle resolves
# it from the GitHub release, so a container built from a clean checkout compiles.
RUN test -f ${HMS_HOME}/hms.jar &&\
    test -d ${HMS_HOME}/lib &&\
    test -d ${HMS_HOME}/bin/gdal &&\
    gradle --version &&\
    java -version
