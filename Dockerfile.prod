# syntax=docker/dockerfile:1
#
# Production image for the HEC-HMS cloud-compute plugin, parameterised by
# HEC-HMS version so CI can build one image per supported version:
#
#   docker build -f Dockerfile.prod --build-arg HMS_VERSION=4.13 \
#       --build-arg CC_SDK_SHA256="$CC_SDK_SHA256" -t hms-runner:local-4.13 .
#
# The list of supported versions lives in .github/workflows/build-push-ghcr.yml.
#
# Deliberate changes from the original Dockerfile.prod. Each one was a blocker
# for building more than one HEC-HMS version; details in docs/ci-cd.md:
#
#   1. The runner is compiled from the build CONTEXT, not from a
#      `git clone ... main` inside the image. CI must build the commit that
#      triggered it, and builds must not need github.com at build time.
#   2. HEC-HMS is always installed at ${HMS_HOME}=/opt/hms, so ENTRYPOINT,
#      CLASSPATH, PATH, GDAL_DATA and PROJ_LIB are version-independent. The
#      version lives in the image tag, not in the in-image path. A
#      /HEC-HMS-<version> -> /opt/hms symlink is kept so existing absolute
#      references keep resolving.
#   3. cc-java-sdk-1.1.2-all.jar is downloaded from the cc-java-sdk GitHub
#      release and checked against a pinned sha256, instead of `COPY deps/...`
#      (deps/ is not in this repository, so the old file cannot build from a
#      clean checkout).
#   4. The runner jar is copied to one fixed path (/hms/hms-runner.jar) so the
#      ENTRYPOINT can be a literal. Docker does NOT expand ${VAR} inside an
#      exec-form ENTRYPOINT array, and the jar gradle produces is named
#      hms-runner-<version>.jar - that combination previously forced a shell
#      launcher. Renaming the jar at COPY time removes it.
#
#      Note the ENTRYPOINT names the apt JRE by absolute path, not `java`: this
#      image's PATH puts ${HMS_HOME}/jre/bin first (inherited from the original
#      image), so a bare `java` would silently run HEC-HMS's bundled JRE instead
#      of the Java 17 runtime the jar is compiled for.
#
# Air-gapped / internal-mirror builds: put HEC-HMS at /opt/hms and the SDK jar at
# /workspaces/deps/cc-java-sdk-all.jar in BUILDER_BASE_IMAGE, then pass
#   --build-arg SKIP_HMS_DOWNLOAD=true --build-arg SKIP_CC_SDK_DOWNLOAD=true
# (or point HMS_TARBALL_URL / CC_SDK_URL at the internal mirror).
#
# Every download uses curl, not `wget -q`. A failed fetch must print the HTTP
# status and the URL and retry transient 429/5xx - two matrix legs can pull ~1 GB
# from the same GitHub source IP at the same moment. `wget -q` reduced all of
# that to "exit code 8" (run 45734328618), which cannot be diagnosed.

# ---- global args (the only ones visible to FROM) ---------------------------
ARG HMS_VERSION=4.13
ARG HMS_PLATFORM=linux64
ARG BUILDER_BASE_IMAGE=eclipse-temurin:17-jdk
# ubuntu:20.04 left standard support in May 2025; its apt pools move to
# old-releases and break unattended builds. Override with ubuntu:20.04 if a
# legacy glibc is ever needed.
ARG RUNTIME_BASE_IMAGE=ubuntu:22.04

# ===========================================================================
# builder: HEC-HMS + Gradle + the plugin fat jar
# ===========================================================================
FROM ${BUILDER_BASE_IMAGE} AS builder

ARG HMS_VERSION
ARG HMS_PLATFORM
# Every image installs HMS here; the version is carried by the image tag.
ARG HMS_HOME=/opt/hms
ARG HMS_NEXUS_BASE=https://www.hec.usace.army.mil/nexus/repository/maven-public
# Set to pull the tarball from an internal mirror instead of HEC Nexus.
ARG HMS_TARBALL_URL=
ARG SKIP_HMS_DOWNLOAD=false

ARG CC_SDK_URL=https://github.com/USACE-Cloud-Compute/cc-java-sdk/releases/download
ARG CC_SDK_VERSION=1.1.2
# Empty = no verification. CI always sets it; see the workflow's CC_SDK_SHA256.
ARG CC_SDK_SHA256=
ARG SKIP_CC_SDK_DOWNLOAD=false

ARG GRADLE_VERSION=7.3.1
# Stamped into the jar name by build.gradle; the prod stage copies that jar to
# one fixed path so the ENTRYPOINT can be a literal.
ARG RUNNER_VERSION=0.0.1

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/New_York \
    GRADLE_HOME=/opt/gradle/latest \
    PATH=/opt/gradle/latest/bin:/usr/local/bin:/usr/bin:/bin \
    HMS_HOME=${HMS_HOME} \
    HMS_VERSION=${HMS_VERSION} \
    CC_SDK_JAR=/workspaces/deps/cc-java-sdk-all.jar

RUN --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        wget curl ca-certificates git unzip \
        libxrender1 libxtst6 libxi6 libfreetype6 libgfortran5 libfontconfig1

# ---- HEC-HMS distribution we compile against -------------------------------
# HEC's own artifact naming is not consistent between releases:
#
#   4.13-linux64/  ->  hec-hms-4.13-linux64-linux64.tar.gz      (platform twice)
#   4.14-linux64/  ->  hec-hms-4.14-linux64.tar.gz              (platform once)
#   4.13-beta.6-linux64/  ->  hec-hms-4.13-beta.6-linux64.tar.gz
#
# So probe both shapes, log which one hit, and allow a leg to pin the exact URL
# via HMS_TARBALL_URL rather than editing this file the next time it drifts.
# A HEAD that is refused, redirected oddly or unreachable is confirmed with a
# 1-byte ranged GET before anything is called missing.
RUN set -eux; \
    if [ "${SKIP_HMS_DOWNLOAD}" = "true" ]; then \
        test -f "${HMS_HOME}/hms.jar"; \
        echo "using pre-baked HEC-HMS at ${HMS_HOME}"; \
        exit 0; \
    fi; \
    dir="${HMS_NEXUS_BASE}/mil/army/usace/hec/hec-hms/${HMS_VERSION}-${HMS_PLATFORM}"; \
    if [ -n "${HMS_TARBALL_URL}" ]; then \
        candidates="${HMS_TARBALL_URL}"; \
    else \
        candidates="${dir}/hec-hms-${HMS_VERSION}-${HMS_PLATFORM}-${HMS_PLATFORM}.tar.gz ${dir}/hec-hms-${HMS_VERSION}-${HMS_PLATFORM}.tar.gz"; \
    fi; \
    found=""; \
    for candidate in ${candidates}; do \
        probe="$(curl -sS -I -L -o /dev/null -w '%{http_code}' \
            --connect-timeout 20 --max-time 60 \
            --retry 3 --retry-delay 5 --retry-all-errors --retry-connrefused \
            "${candidate}" || echo curl-error)"; \
        case "${probe}" in \
            3[0-9][0-9]|405|501|000|curl-error) \
                probe="$(curl -sS -o /dev/null --range 0-0 -L -w '%{http_code}' \
                    --connect-timeout 20 --max-time 60 "${candidate}" || echo curl-error)" ;; \
        esac; \
        echo "probe HTTP ${probe} ${candidate}"; \
        case "${probe}" in 200|206) found="${candidate}"; break ;; esac; \
    done; \
    if [ -z "${found}" ]; then \
        echo "FAIL: no HEC-HMS tarball for ${HMS_VERSION} (${HMS_PLATFORM}); probed:" >&2; \
        for candidate in ${candidates}; do echo "  ${candidate}" >&2; done; \
        echo "linux64 versions Nexus lists for hec-hms (last 12):" >&2; \
        curl -sSL --max-time 60 \
            "${HMS_NEXUS_BASE}/mil/army/usace/hec/hec-hms/maven-metadata.xml" \
            | tr '<' '\n' | sed -n 's/^version>//p' | grep -- '-linux64$' | tail -n 12 >&2 \
            || echo "  (could not read maven-metadata.xml)" >&2; \
        echo "if the directory exists under a different file name, pin it: --build-arg HMS_TARBALL_URL=<url>" >&2; \
        exit 1; \
    fi; \
    echo "GET ${found}"; \
    code="$(curl -sS -L -o /tmp/hms.tar.gz -w '%{http_code}' \
        --connect-timeout 20 --max-time 1800 \
        --retry 5 --retry-delay 15 --retry-all-errors --retry-connrefused \
        "${found}" || echo curl-error)"; \
    if [ "${code}" != "200" ]; then \
        echo "FAIL: HTTP ${code} downloading ${found}" >&2; exit 1; \
    fi; \
    size="$(wc -c < /tmp/hms.tar.gz)"; \
    echo "HTTP ${code}, ${size} bytes"; \
    if [ "${size}" -lt 50000000 ]; then \
        echo "FAIL: ${size} bytes is too small for a HEC-HMS tarball; first 400 bytes:" >&2; \
        head -c 400 /tmp/hms.tar.gz >&2; exit 1; \
    fi; \
    gzip -t /tmp/hms.tar.gz; \
    rm -rf "${HMS_HOME}"; mkdir -p "${HMS_HOME}"; \
    tar -xzf /tmp/hms.tar.gz -C "${HMS_HOME}" --strip-components=1; \
    rm -f /tmp/hms.tar.gz; \
    test -f "${HMS_HOME}/hms.jar"

# ---- cc-java-sdk (fat jar; not committed to git) ---------------------------
RUN set -eux; \
    mkdir -p /workspaces/deps; \
    if [ "${SKIP_CC_SDK_DOWNLOAD}" = "true" ]; then \
        test -f "${CC_SDK_JAR}"; \
        echo "using pre-placed ${CC_SDK_JAR}"; \
        exit 0; \
    fi; \
    url="${CC_SDK_URL}/v${CC_SDK_VERSION}/cc-java-sdk-${CC_SDK_VERSION}-all.jar"; \
    echo "GET ${url}"; \
    code="$(curl -sS -L -o /tmp/cc-java-sdk.jar -w '%{http_code}' \
        --connect-timeout 20 --max-time 900 \
        --retry 5 --retry-delay 10 --retry-all-errors --retry-connrefused \
        "${url}" || echo curl-error)"; \
    if [ "${code}" != "200" ]; then \
        echo "FAIL: HTTP ${code} fetching cc-java-sdk ${CC_SDK_VERSION} from ${url}" >&2; \
        echo "check the release still exists: https://github.com/USACE-Cloud-Compute/cc-java-sdk/releases" >&2; \
        exit 1; \
    fi; \
    size="$(wc -c < /tmp/cc-java-sdk.jar)"; \
    echo "HTTP ${code}, ${size} bytes"; \
    if [ "${size}" -lt 20000000 ]; then \
        echo "FAIL: ${size} bytes is too small for the -all jar; first 400 bytes:" >&2; \
        head -c 400 /tmp/cc-java-sdk.jar >&2; exit 1; \
    fi; \
    if ! unzip -t -qq /tmp/cc-java-sdk.jar > /dev/null; then \
        echo "FAIL: the download is not a valid jar/zip" >&2; \
        head -c 400 /tmp/cc-java-sdk.jar >&2; exit 1; \
    fi; \
    if [ -n "${CC_SDK_SHA256}" ]; then \
        echo "${CC_SDK_SHA256}  /tmp/cc-java-sdk.jar" | sha256sum -c -; \
    else \
        echo "WARNING: CC_SDK_SHA256 is empty - cc-java-sdk was NOT verified"; \
    fi; \
    mv /tmp/cc-java-sdk.jar "${CC_SDK_JAR}"; \
    ls -l "${CC_SDK_JAR}"

# ---- the plugin itself, from the build context -----------------------------
WORKDIR /workspaces/hms-runner
COPY . .

# gradle 7.3.1 is the version the images have always used. This repo ships
# gradle/wrapper/gradle-wrapper.properties but NOT gradle-wrapper.jar, so
# ./gradlew cannot be used until that jar is committed (or regenerated with
# `gradle wrapper`).
RUN --mount=type=cache,target=/root/.gradle \
    set -eux; \
    curl -sS -L -o /tmp/gradle.zip -w 'gradle distribution: HTTP %{http_code}\n' \
        --connect-timeout 20 --max-time 600 \
        --retry 3 --retry-delay 5 --retry-all-errors --retry-connrefused \
        "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"; \
    mkdir -p /opt/gradle; \
    unzip -q -d /opt/gradle /tmp/gradle.zip; \
    ln -sfn "/opt/gradle/gradle-${GRADLE_VERSION}" /opt/gradle/latest; \
    gradle --no-daemon --console=plain --stacktrace \
        -PhmsHome="${HMS_HOME}" \
        -PccSdkJar="${CC_SDK_JAR}" \
        -PrunnerVersion="${RUNNER_VERSION}" \
        build -x test; \
    ls -l build/libs

# ===========================================================================
# prod: JRE + HEC-HMS runtime + plugin jar
# ===========================================================================
FROM ${RUNTIME_BASE_IMAGE} AS prod

ARG HMS_VERSION
ARG HMS_HOME=/opt/hms

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/New_York

RUN --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libxrender1 libxtst6 libxi6 libfreetype6 libgfortran5 libfontconfig1 \
        openjdk-17-jre ca-certificates

ENV HMS_HOME=${HMS_HOME} \
    PROG=hms.hms \
    PATH=${HMS_HOME}/bin/taudem:${HMS_HOME}/bin/mpi:${HMS_HOME}/bin:${HMS_HOME}/jre/bin/:${HMS_HOME}/jre/lib/:/usr/local/bin:/usr/bin:/bin \
    GDAL_DATA=${HMS_HOME}/bin/gdal/gdal-data \
    PROJ_LIB=${HMS_HOME}/bin/gdal/proj \
    CLASSPATH=${HMS_HOME}/*:${HMS_HOME}/lib/*:${HMS_HOME}/lib/hec/*:${HMS_HOME}/jre/lib/* \
    JAVA_TOOL_OPTIONS=-Djava.library.path=${HMS_HOME}/bin/gdal:${HMS_HOME}/bin:${HMS_HOME}/bin/taudem:${HMS_HOME}/bin/mpi:${HMS_HOME}/jre/bin:${HMS_HOME}/jre/lib/

# ${HMS_HOME} is the same string in every image, so the native library path has
# no version in it either. It travels as JAVA_TOOL_OPTIONS because the JVM reads
# that at startup, which lets the ENTRYPOINT stay a literal array. To override
# it, set JAVA_TOOL_OPTIONS on the container (it replaces the whole value).
COPY --from=builder ${HMS_HOME}/ ${HMS_HOME}/
COPY --from=builder /workspaces/deps/cc-java-sdk-all.jar ${HMS_HOME}/lib/
# One jar in, fixed name out. If gradle ever leaves two hms-runner-*.jar files
# here, COPY fails the build instead of silently picking one.
COPY --from=builder /workspaces/hms-runner/build/libs/hms-runner-*.jar /hms/hms-runner.jar

RUN set -eux; \
    ln -sfn "${HMS_HOME}" "/HEC-HMS-${HMS_VERSION}"; \
    test -f "${HMS_HOME}/hms.jar"; \
    test -f /hms/hms-runner.jar; \
    test -x /usr/lib/jvm/java-17-openjdk-amd64/bin/java

# Parity with the old image (its `WORKDIR hms` resolved to /hms). The runner
# should probably get a writable scratch dir instead - tracked as a follow-up.
WORKDIR /hms

ENTRYPOINT ["/usr/lib/jvm/java-17-openjdk-amd64/bin/java", "-jar", "/hms/hms-runner.jar"]
