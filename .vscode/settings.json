{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.test.config": {
    // Same fix as launch.json: this named /HEC-HMS-4.12, which no container in
    // this repo ever installed (Dockerfile_13_6 installs 4.13-beta.6), and two
    // of the six entries were missing their leading "/". So tests run from the
    // Java Test view never picked up the HEC-HMS native libraries -- only
    // `gradle test`, which sets java.library.path itself, worked.
    // /hms is HMS_HOME in Dockerfile_13_6 and the default hmsHome in build.gradle.
    "vmArgs": ["-Djava.library.path=/hms/bin/gdal:/hms/bin:/hms/bin/taudem:/hms/bin/mpi:/hms/jre/bin:/hms/jre/lib/"],
    //"envFile": "${workspaceFolder}/.env"
  },
  "java.compile.nullAnalysis.mode": "automatic"
}
